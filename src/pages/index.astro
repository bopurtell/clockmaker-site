---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const introduction = await getEntry('blog', 'introduction');
if (!introduction) throw new Error('Introduction post not found');
const { Content } = await render(introduction);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<Header />
		<main>
			<section class="landing-intro">
				<h1 class="landing-title">CLOCKMAKER IN CARTERET && FRIENDS</h1>
				<div class="landing-quote">
					<p>"Celer esto, primus esto, sed recte fac."</p>
					<p>My quest to be the hare.</p>
				</div>
			</section>

			<section class="article-header">
				<h2 class="article-title">{introduction.data.title}</h2>
				<div class="article-meta">
					<span>English</span>
					<time datetime={introduction.data.pubDate.toISOString()}>
						{introduction.data.pubDate.toLocaleDateString('en-GB', {
							day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC',
						})}
					</time>
				</div>
			</section>

			<Content />

		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		background: #fff;
	}

	.landing-intro {
		margin-bottom: 3rem;
		text-align: center;
	}

	.landing-title {
		font-size: clamp(0.9rem, 4vw, 2rem);
		text-align: center;
		white-space: nowrap;
	}

	.landing-quote {
		margin: 0 auto;
		color: rgb(var(--black));
		font-size: 1rem;
		line-height: 1.4;
		text-align: center;
	}

	.landing-quote p {
		margin: 0;
	}

	.article-title {
		margin-bottom: 0.15rem;
	}

	.article-meta {
		margin-bottom: 1.5rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		line-height: 1.25;
	}

	.article-meta span,
	.article-meta time {
		display: block;
	}
</style>
